{
  "name": "goalposts",
  "version": "0.1.0",
  "description": "Did your coding agent move the goalposts? Finds tests, checks and CI gates that were weakened to make a diff pass.",
  "type": "module",
  "bin": {
    "goalposts": "bin/goalposts.js"
  },
  "files": [
    "bin",
    "src",
    "docs/rules.md",
    "action.yml",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run typecheck && npm test",
    "docs": "node scripts/gen-rules-doc.js",
    "demo": "node bin/goalposts.js demo",
    "render-demo": "node scripts/render-demo-svg.js"
  },
  "keywords": [
    "ai-agents",
    "coding-agents",
    "claude-code",
    "code-review",
    "test-quality",
    "git",
    "cli",
    "ci",
    "developer-tools"
  ],
  "author": "Nithinfgs",
