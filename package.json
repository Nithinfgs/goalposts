  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nithinfgs/goalposts.git"
  },
  "bugs": {
    "url": "https://github.com/Nithinfgs/goalposts/issues"
  },
  "homepage": "https://github.com/Nithinfgs/goalposts#readme",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
